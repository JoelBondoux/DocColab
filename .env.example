# AI providers (set only the provider you enable in config.json)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub fine-grained PAT: Contents read/write, Pull requests read/write
GITHUB_TOKEN=

# Microsoft Entra public-client application ID
MICROSOFT_CLIENT_ID=

# Random high-entropy values used to authenticate webhook notifications
GOOGLE_WEBHOOK_TOKEN=replace-with-at-least-32-random-characters

# Optional: override config.json model IDs without editing the file
DOCCOLAB_OPENAI_MODEL=
DOCCOLAB_ANTHROPIC_MODEL=
